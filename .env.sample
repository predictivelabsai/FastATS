FASTATS_DB=./data/fastats.sqlite
FASTATS_DATABASE_URL=
FASTATS_DB_SCHEMA=fast_ats
FASTATS_SECRET=change-me
FASTATS_PORT=5020
FASTATS_ADMIN_EMAIL=admin@fastats.example
FASTATS_ADMIN_PASSWORD=FastATS2026$
FASTATS_UPLOAD_DIR=./data/uploads

# --- Language model (provider-agnostic via LangChain) ---
# MODEL_PROVIDER: xai (default) | openai | anthropic | google_genai
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- LangGraph checkpointer: memory (default) | sqlite | postgres ---
FASTATS_CHECKPOINTER=memory

# --- Object storage: local (default) | r2 ---
FASTATS_STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Embeddings: fake (default, offline) | hosted ---
FASTATS_EMBEDDINGS_BACKEND=fake
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_DIM=1536

# --- Google SSO (optional; reuses the fastsme login pattern) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ats.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAINS=

# --- Email: console (default) | smtp | postmark ---
FASTATS_EMAIL_BACKEND=console
POSTMARK_API_TOKEN=
FROM_EMAIL=jobs@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
